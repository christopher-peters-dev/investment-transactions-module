{
  "name": "@christopher-peters-dev/investment-transactions",
  "version": "1.0.0",
  "description": "Independent investment transactions feature; composed by an RN host",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --runInBand",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "package:module": "node scripts/package-module.mjs",
    "dev:check": "npm run typecheck && npm run lint && npm run check:boundaries && npm test",
    "test:watch": "jest --watchAll"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "react-native": "0.87.1",
    "@christopher-peters-dev/investment-platform": "1.0.2"
  },
  "devDependencies": {
    "@christopher-peters-dev/investment-platform": "1.0.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "5.10.1",
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "pocArtifactDirectory": "../artifacts"
}
